# ---- Admin password (панель /admin) ----
# Придумай свой пароль. Если не задать — по умолчанию будет admin123
ADMIN_PASSWORD=change-me-please

# ---- Upstash Redis (общая база на проде) ----
# Возьми в Upstash или через интеграцию Upstash в Vercel Marketplace.
# Без них локально данные пишутся в файл .data/db.json, а на Vercel — только в память
# одного инстанса (не общая, сбрасывается). Для реальной работы на Vercel — задай их.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
